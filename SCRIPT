local function updatePlayerList(filter)
    filter = (filter or ""):lower()

    for name, p in pairs(getgenv().SelectedTargets) do
        if not p or not p.Parent then getgenv().SelectedTargets[name] = nil end
    end

    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local y, count = 0, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local n = p.Name:lower()
            local d = p.DisplayName:lower()
            if filter == "" or n:find(filter, 1, true) or d:find(filter, 1, true) then
                local isSel = getgenv().SelectedTargets[p.Name] ~= nil
                if isSel then count = count + 1 end

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -6, 0, 22)
                btn.Position = UDim2.new(0, 3, 0, y)
                btn.BackgroundColor3 = isSel and THEME.accent or THEME.panelAlt
                btn.BorderSizePixel = 0
                btn.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"
                btn.TextColor3 = THEME.text
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 10
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.Parent = Scroll
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

                btn.MouseButton1Click:Connect(function()
                    if getgenv().SelectedTargets[p.Name] then
                        getgenv().SelectedTargets[p.Name] = nil
                    else
                        getgenv().SelectedTargets[p.Name] = p
                    end
                    updatePlayerList(currentFilter)
                end)

                y = y + 25
            end
        end
    end

    Scroll.CanvasSize = UDim2.new(0, 0, 0, y + 4)
    FooterRight.Text = "Selected: " .. count
end

