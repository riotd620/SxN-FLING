-- ===== HELPERS =====
local function setCollision(char, state)
    if not char then return end
    pcall(function()
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = state
                v.CanTouch = state
            end
        end
    end)
end

local function clearBodyMovers(character)
    if not character then return end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BodyMover") or v:IsA("BodyVelocity") or v:IsA("BodyPosition")
           or v:IsA("BodyGyro") or v:IsA("BodyAngularVelocity") or v:IsA("BodyThrust")
           or v:IsA("LinearVelocity") or v:IsA("AngularVelocity") or v:IsA("VectorForce") then
            v:Destroy()
        end
    end
end

-- ===== FLING (original RX BAAP logic) =====
local function flingPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == lp or not targetPlayer.Parent then return end
    if not targetPlayer.Character or isFlinging then return end

    local tChar = targetPlayer.Character
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHum  = tChar:FindFirstChildOfClass("Humanoid")
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not tRoot or not myRoot or not myHum then return end

    isFlinging = true
    local originalLocation = myRoot.CFrame
    local power    = getgenv().FlingPower or 1e9
    local duration = getgenv().FlingDuration or 2.0

    clearBodyMovers(tChar)
    if tHum then
        tHum.PlatformStand = true
        tHum.Sit = false
        pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Physics) end)
    end
    tRoot.Anchored = false

    local bv_t = Instance.new("BodyVelocity", tRoot)
    bv_t.MaxForce = Vector3.new(power, power, power)
    bv_t.Velocity = Vector3.new(0, power, 0)
    bv_t.P = power

    local bav_t = Instance.new("BodyAngularVelocity", tRoot)
    bav_t.MaxTorque = Vector3.new(power, power, power)
    bav_t.AngularVelocity = Vector3.new(power, power, power)
    bav_t.P = power

    local attach_t = Instance.new("Attachment", tRoot)
    local lv_t = Instance.new("LinearVelocity", tRoot)
    lv_t.MaxForce = power
    lv_t.Attachment0 = attach_t
    lv_t.VectorVelocity = Vector3.new(0, power, 0)

    local attach_t2 = Instance.new("Attachment", tRoot)
    local vf_t = Instance.new("VectorForce", tRoot)
    vf_t.Force = Vector3.new(power, power, power)
    vf_t.Attachment0 = attach_t2

    setCollision(myChar, true)

    local bv_s = Instance.new("BodyVelocity", myRoot)
    bv_s.MaxForce = Vector3.new(power, power, power)
    bv_s.Velocity = Vector3.new(0, power, 0)
    bv_s.P = power

    local bav_s = Instance.new("BodyAngularVelocity", myRoot)
    bav_s.MaxTorque = Vector3.new(power, power, power)
    bav_s.AngularVelocity = Vector3.new(power, power, power)
    bav_s.P = power

    local attach_s = Instance.new("Attachment", myRoot)
    local lv_s = Instance.new("LinearVelocity", myRoot)
    lv_s.MaxForce = power
    lv_s.Attachment0 = attach_s
    lv_s.VectorVelocity = Vector3.new(0, power, 0)

    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        pcall(function()
            if not tRoot or not tRoot.Parent or not myRoot or not myRoot.Parent
               or tick() - startTime > duration
               or SESSION ~= getgenv().SxN_NITISH_SESSION then
                if conn then conn:Disconnect() end
                return
            end
            local a = tick() * 45
            local offset = Vector3.new(math.sin(a) * 0.3, -0.2 + math.sin(a * 1.3) * 0.4, math.cos(a) * 0.3)
            myRoot.CFrame = CFrame.new(tRoot.Position + offset) * CFrame.Angles(
                math.rad(tick() * 9000), math.rad(tick() * 9000), math.rad(tick() * 9000)
            )
            bv_t.Velocity = Vector3.new(0, power, 0)
            bav_t.AngularVelocity = Vector3.new(power, power, power)
            lv_t.VectorVelocity = Vector3.new(0, power, 0)
            vf_t.Force = Vector3.new(power, power, power)
            bv_s.Velocity = Vector3.new(0, power, 0)
            bav_s.AngularVelocity = Vector3.new(power, power, power)
            lv_s.VectorVelocity = Vector3.new(0, power, 0)
        end)
    end)

    repeat wait() until not conn.Connected

    pcall(function()
        bv_t:Destroy() bav_t:Destroy() lv_t:Destroy() attach_t:Destroy()
        vf_t:Destroy() attach_t2:Destroy()
        bv_s:Destroy() bav_s:Destroy() lv_s:Destroy() attach_s:Destroy()
        if tHum then
            tHum.PlatformStand = false
            pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Falling) end)
        end
        if myRoot and myRoot.Parent then
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            myRoot.CFrame = originalLocation
        end
        if myHum then pcall(function() myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        setCollision(myChar, not getgenv().Noclip)
    end)

    isFlinging = false
end

-- ===== TOGGLES =====
updateNoclip = function()
    if getgenv().Noclip then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                if lp.Character then setCollision(lp.Character, false) end
            end)
        end
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
            if lp.Character then setCollision(lp.Character, true) end
        end
    end
end

updateAntiFling = function()
    if getgenv().AntiFling then
        if not antiFlingConn then
            antiFlingConn = RunService.Heartbeat:Connect(function()
                if isFlinging then return end
                pcall(function()
                    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    local hum = lp.Character:FindFirstChildOfClass("Humanoid")
                    if hrp.AssemblyLinearVelocity.Magnitude > 400
                       or hrp.AssemblyAngularVelocity.Magnitude > 400 then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.CFrame = CFrame.new(lastSafePos)
                    elseif hrp.AssemblyLinearVelocity.Magnitude < 20 and hum then
                        local st = hum:GetState()
                        if st == Enum.HumanoidStateType.Running
                           or st == Enum.HumanoidStateType.Landed
                           or st == Enum.HumanoidStateType.RunningNoPhysics then
                            lastSafePos = hrp.Position
                        end
                    end
                end)
            end)
        end
    else
        if antiFlingConn then
            antiFlingConn:Disconnect()
            antiFlingConn = nil
        end
    end
end

